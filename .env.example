# CFD-Bench Docker v22.4.1 does not publish PostgreSQL or IoTDB ports to the host.
# Database communication stays on the private Compose network:
#   PostgreSQL: postgres:5432
#   IoTDB:      iotdb:6667

# IoTDB switches the DataNode to ReadOnly(DiskFull) when the remaining disk
# fraction falls below this value. Upstream default is 0.05 (5%). CFD-Bench
# uses 0.01 (1%) by default in compose.yaml; override it here if desired.
CFD_BENCH_IOTDB_DISK_SPACE_WARNING_THRESHOLD=0.01
